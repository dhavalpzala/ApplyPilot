# ApplyPilot pulls @playwright/mcp from the public npm registry.
#
# NOTE: this file only applies to npm/npx commands run from inside this repo.
# It does NOT affect the apply stage — run_job() spawns the claude CLI (and so
# npx) with cwd set to ~/.applypilot/apply-workers/worker-N, which is wiped by
# reset_worker_dir() before every job. That path is configured via
# npm_config_registry in ~/.applypilot/.env instead.
registry=https://registry.npmjs.org/
